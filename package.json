{
  "name": "tli-profit-tracker",
  "version": "0.9.15",
  "description": "TLI Companion - live profit tracker, farm sessions, strategies and class meta for Torchlight: Infinite",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/run-on-log.js",
    "dist": "electron-builder --win",
    "beta": "node scripts/build-beta.js"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": "TLI Companion",
  "build": {
    "appId": "local.tli.profit",
    "productName": "TLI Companion",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "data/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TLI Companion",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "TLI-Companion-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "TLI-Companion-Portable-${version}.exe"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://tlicompanion.com/download/"
      }
    ]
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/julien-szy/tli-companion.git"
  },
  "homepage": "https://tlicompanion.com",
  "private": true
}
